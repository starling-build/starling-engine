    ]
  } else {
    deps += [
      "//flutter/lib/ui:ui_plumbing",
      "//flutter/runtime:runtime_interface",
    ]
  }

  # Forward engine registry and runtime controller headers so dependents
  # (like blue_screen_demo and the embedder) can include them.
  public_deps += [
    "//flutter/lib/ui/swift:swift_bridge_engine_registry",
    "//flutter/lib/ui/swift:swift_runtime_controller",
  ]

  if (impeller_supports_rendering) {
    sources += [
      "snapshot_controller_impeller.cc",
      "snapshot_controller_impeller.h",
    ]

    deps += [ "//flutter/impeller" ]
  }
}

