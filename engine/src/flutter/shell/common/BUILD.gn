    ":display",
    ":platform_message_handler",
    "//flutter/shell/version",
    "//flutter/third_party/rapidjson",
    "//flutter/txt",
  ]

  # RunConfiguration describes which Dart isolate to launch; there is none.
  if (flutter_enable_dart) {
    sources += [
      "run_configuration.cc",
