    "//flutter/shell/profiling",
    "//flutter/skia",
  ]

  # The VM, its bindings and the full dart:ui -- or the plumbing half of
  # lib/ui and the runtime-controller interface on its own. See
  # flutter_enable_dart in //flutter/common/config.gni.
  if (flutter_enable_dart) {
    deps += [
      "$dart_src/runtime:dart_api",
      "//flutter/lib/ui",
