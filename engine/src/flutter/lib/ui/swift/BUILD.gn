# GN build file for Flutter Swift Bridge C++ code.
#
# This builds the C++ bridge layer that provides Swift-compatible headers
# and implementations for the dart:ui to Swift migration.
#
# Architecture:
#   include/  - Swift-compatible headers (NO Flutter engine includes)
#   src/      - Implementations (CAN include Flutter engine headers)
#
# The bridge headers use SWIFT_SHARED_REFERENCE for automatic memory
# management via Swift ARC.

import("//flutter/common/config.gni")

# On Linux, override the default -z,defs to allow undefined symbols in the
# shared library. These symbols (SwiftBridgeEngineRegistry methods) are
# resolved at load time from the main executable, mirroring the macOS
# -undefined dynamic_lookup behavior.
config("swift_bridge_allow_undefined") {
  if (is_linux) {
    ldflags = [ "-Wl,-z,undefs" ]
  }
}

# <swift/bridging> ships with the Swift toolchain, so a path to it is
# unavoidable here — unlike the Swift packages downstream, which resolve it
# from a vendored copy. It is overridable because not every build uses a
# Swiftly-managed toolchain: a distro packager builds against the system
# Swift, and until this existed had to patch the line below by hand.
#
#   $STARLING_SWIFT_INCLUDE    the include directory itself, for a layout
#                              that is not <toolchain>/usr/include (Arch
#                              puts it at /usr/lib/swift/include)
#   $STARLING_SWIFT_TOOLCHAIN  the toolchain root, the same variable
#                              starling's bootstrap.sh reads
#
# Nested rather than a flat else-if chain: GN rejects a variable that is
# assigned and then never read, so the toolchain root must only be fetched
# on the branch that actually consumes it.
_swift_include_override = getenv("STARLING_SWIFT_INCLUDE")

if (_swift_include_override != "") {
  _swift_toolchain_include = _swift_include_override
} else {
  _swift_toolchain_root = getenv("STARLING_SWIFT_TOOLCHAIN")
  if (_swift_toolchain_root != "") {
    _swift_toolchain_include = _swift_toolchain_root + "/usr/include"
  } else if (is_mac || is_ios) {
    _swift_toolchain_include =
        getenv("HOME") +
        "/Library/Developer/Toolchains/swift-6.2.1-RELEASE.xctoolchain/usr/include"
  } else if (is_win) {
    # swift.org's Windows installer is per-user, under %LOCALAPPDATA%; there is
    # no system-wide location to fall back on. A toolchain placed anywhere else
    # (or a different version) must set STARLING_SWIFT_TOOLCHAIN.
    _swift_toolchain_include =
        getenv("LOCALAPPDATA") +
        "/Programs/Swift/Toolchains/6.2.3+Asserts/usr/include"
  } else {
    _swift_toolchain_include =
        getenv("HOME") + "/.local/share/swiftly/toolchains/6.2.4/usr/include"
  }
}

config("swift_bridge_config") {
  include_dirs = [ "." ]

  # Every target that compiles these headers is part of the engine side, so it
  # is the one that exports. See swift_bridge_export.h.
  defines = [ "FLUTTER_SWIFT_BRIDGE_IMPLEMENTATION" ]

  # Visibility annotations for shared library exports
  if (is_mac || is_ios || is_linux) {
    cflags = [
      "-fvisibility=default",
      # Swift toolchain headers for <swift/bridging>
      "-isystem",
      _swift_toolchain_include,
    ]
  } else if (is_win) {
    # clang-cl spells the system-include flag /imsvc, and takes it joined
    # rather than as a separate argument. -fvisibility has no meaning here:
    # what a DLL exports comes from the dllexport in swift_bridge_export.h.
    cflags = [ "/imsvc" + _swift_toolchain_include ]

    # The bridge converts radians to degrees with M_PI in three files
    # (gradient, path, canvas). glibc and libc++ hand those constants out
    # unconditionally; the UCRT only defines them when this is set before
    # <math.h> is first reached, so it has to come from the command line
    # rather than a #define in any one source file.
    defines += [ "_USE_MATH_DEFINES" ]
  }
}

# Header-only target for the reference counting base class.
# This is used by all bridge classes.
source_set("intrusive_reference_counted") {
  sources = [ "include/intrusive_reference_counted.h" ]

  public_configs = [ ":swift_bridge_config" ]
}

# Header-only target for SwiftBridgeEngineRegistry.
# Used by the swift_bridge shared library to include the header without
# linking the implementation (which lives in the executable).
source_set("swift_bridge_engine_registry_headers") {
  sources = [
    "include/swift_bridge_engine_registry.h",
    "include/swift_bridge_export.h",
  ]

  public_configs = [
    ":swift_bridge_config",
    "//flutter:config",
  ]
}

# Implementation of SwiftBridgeEngineRegistry (static members).
# Linked into the executable via //flutter/shell/common. The swift_bridge
# shared library resolves these symbols at load time from the executable
# via -undefined dynamic_lookup.
source_set("swift_bridge_engine_registry") {
  sources = [
    "include/swift_bridge_engine_registry.h",
    "include/swift_bridge_export.h",
    "src/swift_bridge_engine_registry.cc",
  ]

  public_configs = [
    ":swift_bridge_config",
    "//flutter:config",
  ]
}

# SwiftRuntimeController — uses the C callback table, no Swift dependency.
# Built as part of the engine; the Swift side fills in the callbacks at runtime.
source_set("swift_runtime_controller") {
  sources = [
    "include/swift_runtime_callbacks.h",
    "include/swift_runtime_controller.h",
    "src/swift_runtime_controller.cc",
  ]

  public_configs = [
    ":swift_bridge_config",
    "//flutter:config",
  ]

  public_deps = [ ":swift_bridge_engine_registry" ]

  # This class implements RuntimeControllerInterface and includes nothing else
  # from //flutter/runtime, so with no VM it takes the interface alone rather
  # than a target whose deps are libdart, tonic and dart_io_api.
  if (flutter_enable_dart) {
    public_deps += [ "//flutter/runtime" ]
  } else {
    public_deps += [ "//flutter/runtime:runtime_interface" ]
  }

  deps = [ "//flutter/fml" ]

  # tonic came in for the Dart error type the interface reports; with no VM
  # that is an enum in dart_stubs.h, and this was the last edge dragging
  # tonic -- and with it Dart_CurrentIsolate/EnterIsolate/ExitIsolate -- into
  # the engine library.
  if (flutter_enable_dart) {
    deps += [ "//flutter/third_party/tonic" ]
  }
}

# Main Swift bridge library.
# Add bridge implementations here as modules are migrated.
shared_library("swift_bridge") {
  sources = [
    # Bridge headers (Swift-compatible, no Flutter includes)
    "include/intrusive_reference_counted.h",
    "include/swift_bridge_export.h",
    "include/rsuperellipse_bridge.h",
    "include/channel_buffers_bridge.h",
    "include/shader_bridge.h",
    "include/gradient_bridge.h",
    "include/image_bridge.h",
    "include/image_shader_bridge.h",
    "include/fragment_program_bridge.h",
    "include/fragment_shader_bridge.h",
    "include/path_bridge.h",
    "include/path_measure_bridge.h",
    "include/vertices_bridge.h",
    "include/immutable_buffer_bridge.h",
    "include/color_filter_bridge.h",
    "include/image_filter_bridge.h",
    "include/codec_bridge.h",
    "include/canvas_bridge.h",
    "include/picture_bridge.h",
    "include/image_descriptor_bridge.h",
    "include/engine_layer_bridge.h",
    "include/scene_bridge.h",
    "include/scene_builder_bridge.h",
    "include/platform_dispatcher_bridge.h",
    "include/semantics_flags_bridge.h",
    "include/spell_out_string_attribute_bridge.h",
    "include/locale_string_attribute_bridge.h",
    "include/semantics_update_bridge.h",
    "include/semantics_update_builder_bridge.h",
    "include/paragraph_bridge.h",
    "include/paragraph_builder_bridge.h",
    "include/font_collection_bridge.h",
    "include/view_bridge.h",

    # Bridge implementations
    "src/rsuperellipse_bridge.cc",
    "src/channel_buffers_bridge.cc",
    "src/shader_bridge.cc",
    "src/gradient_bridge.cc",
    "src/image_bridge.cc",
    "src/image_shader_bridge.cc",
    "src/fragment_program_bridge.cc",
    "src/fragment_shader_bridge.cc",
    "src/path_bridge.cc",
    "src/path_measure_bridge.cc",
    "src/vertices_bridge.cc",
    "src/immutable_buffer_bridge.cc",
    "src/color_filter_bridge.cc",
    "src/image_filter_bridge.cc",
    "src/codec_bridge.cc",
    "src/canvas_bridge.cc",
    "src/picture_bridge.cc",
    "src/image_descriptor_bridge.cc",
    "src/engine_layer_bridge.cc",
    "src/scene_bridge.cc",
    "src/scene_builder_bridge.cc",
    "src/platform_dispatcher_bridge.cc",
    "src/semantics_flags_bridge.cc",
    "src/spell_out_string_attribute_bridge.cc",
    "src/locale_string_attribute_bridge.cc",
    "src/semantics_update_bridge.cc",
    "src/semantics_update_builder_bridge.cc",
    "src/paragraph_bridge.cc",
    "src/paragraph_builder_bridge.cc",
    "src/font_collection_bridge.cc",
    "src/view_bridge.cc",

    # Future bridge implementations:
    # "src/paint_bridge.cc",
    # "src/picture_recorder_bridge.cc",
  ]

  public_configs = [
    ":swift_bridge_config",
    "//flutter:config",
  ]

  # SwiftBridgeEngineRegistry symbols are resolved at load time from the
  # executable (which links the swift_bridge_engine_registry source_set via
  # //flutter/shell/common). This avoids duplicate statics between the dylib
  # and executable.
  #
  # The install name has to be set here. //build/toolchain/mac's solink rule
  # passes no -install_name at all, so ld64 falls back to the -o path — which
  # is "./libswift_bridge.dylib", relative to the *working directory*. A
  # consumer then links fine and dies at launch unless it happens to be run
  # from this out directory, and an -rpath does not help: rpath is only
  # consulted for an @rpath-prefixed load path. FlutterMacOS.framework sets
  # its own for the same reason (shell/platform/darwin/macos/BUILD.gn).
  if (is_mac || is_ios) {
    ldflags = [
      "-undefined",
      "dynamic_lookup",
      "-Wl,-install_name,@rpath/libswift_bridge.dylib",
    ]
  }
  if (is_linux) {
    # Applied via config so it comes AFTER the default -z,defs from
    # //build/config/compiler:compiler (last -z flag wins).
    configs += [ ":swift_bridge_allow_undefined" ]
  }

  deps = [
    ":intrusive_reference_counted",
    ":swift_bridge_engine_registry_headers",
    "//flutter/display_list",
    "//flutter/impeller/core",
    "//flutter/impeller/geometry",
    "//flutter/fml",
    "//flutter/impeller/runtime_stage",
    "//flutter/skia",
    "//flutter/skia/modules/skparagraph",
    "//flutter/flow",
    "//flutter/txt",
  ]
}

