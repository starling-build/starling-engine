+// Starling: an ideographic space (U+3000) is a character of its line as an
+// ideograph is, an em that justification spaces like the ideographs either
+// side; the line's other spaces give up their width to the stretch. Spread
+// as a space, a Chinese line's "　" shrank to the step, and a justified
+// paragraph that opens with two of them began its first line in the margin.
+static bool isIdeographicSpace(const Cluster* cluster) {
+    auto text = cluster->getOwner()->text();
+    auto range = cluster->textRange();
+    return range.width() == 3 && static_cast<unsigned char>(text[range.start]) == 0xE3 &&
+           static_cast<unsigned char>(text[range.start + 1]) == 0x80 &&
+           static_cast<unsigned char>(text[range.start + 2]) == 0x80;
+}
+
+static bool isSpreadSpace(const Cluster* cluster) {
+    return cluster->isWhitespaceBreak() && !isIdeographicSpace(cluster);
+}
+
+static bool isSpreadIdeograph(const Cluster* cluster) {
+    return cluster->isIdeographic() || isIdeographicSpace(cluster);
+}
