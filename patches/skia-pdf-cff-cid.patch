+namespace {
+
+uint32_t be(const uint8_t* p, int n) {
+    uint32_t v = 0;
+    for (int i = 0; i < n; ++i) { v = (v << 8) | p[i]; }
+    return v;
+}
+
+// The end of the CFF INDEX at `pos`, or 0 if it does not fit in `size` bytes.
+size_t cff_index_end(const uint8_t* d, size_t size, size_t pos) {
+    if (pos + 2 > size) { return 0; }
+    uint32_t count = be(d + pos, 2);
+    if (count == 0) { return pos + 2; }
+    if (pos + 3 > size) { return 0; }
+    int offSize = d[pos + 2];
+    if (offSize < 1 || offSize > 4) { return 0; }
+    size_t offsets = pos + 3;
+    size_t last = offsets + (size_t)count * offSize;
+    if (last + offSize > size) { return 0; }
+    uint32_t end = be(d + last, offSize);
+    size_t endPos = offsets + (size_t)(count + 1) * offSize + end - 1;
+    return endPos <= size ? endPos : 0;
+}
+
+}  // namespace
+
+namespace {
+
+// The 'CFF ' table of an sfnt, or an empty span.
+bool find_cff(const SkData* sfnt, const uint8_t** cff, size_t* cffSize) {
+    if (!sfnt || sfnt->size() < 12) { return false; }
+    const uint8_t* f = sfnt->bytes();
+    uint32_t numTables = be(f + 4, 2);
+    for (uint32_t i = 0; i < numTables && 12 + (size_t)(i + 1) * 16 <= sfnt->size(); ++i) {
+        const uint8_t* rec = f + 12 + (size_t)i * 16;
+        if (be(rec, 4) == SkSetFourByteTag('C', 'F', 'F', ' ')) {
+            size_t off = be(rec + 8, 4), len = be(rec + 12, 4);
+            if (off + len > sfnt->size() || len < 4) { return false; }
+            *cff = f + off;
+            *cffSize = len;
+            return true;
+        }
+    }
+    return false;
+}
+
+struct CffTop {
+    bool cidKeyed = false;
+    int64_t charsetOperand = -1;  // where the charset operand sits in the CFF
+    size_t charsetOperandLen = 0;
+    int64_t charStrings = 0;
+};
+
+// Walk the Top DICT for charset (op 15), CharStrings (op 17) and ROS (op 12 30).
+bool parse_cff_top(const uint8_t* cff, size_t cffSize, CffTop* top) {
+    size_t pos = cff_index_end(cff, cffSize, cff[2]);
+    if (!pos || pos + 3 > cffSize || be(cff + pos, 2) != 1) { return false; }
+    int offSize = cff[pos + 2];
+    if (offSize < 1 || offSize > 4 || pos + 3 + 2 * (size_t)offSize > cffSize) { return false; }
+    size_t dictStart = pos + 3 + 2 * (size_t)offSize - 1 + be(cff + pos + 3, offSize);
+    size_t dictEnd = pos + 3 + 2 * (size_t)offSize - 1 + be(cff + pos + 3 + offSize, offSize);
+    if (dictEnd > cffSize || dictStart >= dictEnd) { return false; }
+    size_t operandStart = dictStart;
+    int64_t lastInt = 0;
+    for (size_t i = dictStart; i < dictEnd;) {
+        uint8_t b = cff[i];
+        if (b <= 21) {
+            size_t opLen = (b == 12) ? 2 : 1;
+            if (i + opLen > dictEnd) { return false; }
+            int op = (b == 12) ? 1200 + cff[i + 1] : b;
+            if (op == 1230) { top->cidKeyed = true; }
+            if (op == 15) { top->charsetOperand = (int64_t)operandStart; top->charsetOperandLen = i - operandStart; }
+            if (op == 17) { top->charStrings = lastInt; }
+            i += opLen;
+            operandStart = i;
+        } else if (b == 28) {
+            if (i + 3 > dictEnd) { return false; }
+            lastInt = (int16_t)be(cff + i + 1, 2); i += 3;
+        } else if (b == 29) {
+            if (i + 5 > dictEnd) { return false; }
+            lastInt = (int32_t)be(cff + i + 1, 4); i += 5;
+        } else if (b == 30) {
+            ++i;
+            while (i < dictEnd && (cff[i] & 0x0f) != 0x0f && (cff[i] >> 4) != 0x0f) { ++i; }
+            ++i;
+        } else if (b >= 32 && b <= 246) {
+            lastInt = (int)b - 139; ++i;
+        } else if (b >= 247 && b <= 250) {
+            if (i + 2 > dictEnd) { return false; }
+            lastInt = ((int)b - 247) * 256 + cff[i + 1] + 108; i += 2;
+        } else if (b >= 251 && b <= 254) {
+            if (i + 2 > dictEnd) { return false; }
+            lastInt = -((int)b - 251) * 256 - cff[i + 1] - 108; i += 2;
+        } else {
+            return false;
+        }
+    }
+    return true;
+}
+
+}  // namespace
+
+sk_sp<SkData> SkPDFSubsetCFF(const SkTypeface& typeface, const SkPDFGlyphUse& glyphUsage) {
+    // The glyph ids the page uses, ascending, without .notdef.
+    std::vector<uint32_t> gids;
+    glyphUsage.getSetValues([&gids](unsigned gid) { if (gid != 0) { gids.push_back(gid); } });
+    std::sort(gids.begin(), gids.end());
+
+    // First pack the glyphs (no retained gids): a CID-keyed CFF then holds only the glyphs used,
+    // and we give it a charset that maps each packed glyph back to its original gid, which is the
+    // CID the page content names.
+    sk_sp<SkData> sfnt = subset_harfbuzz(typeface, glyphUsage, /*retainGids=*/false);
+    const uint8_t* cff = nullptr;
+    size_t cffSize = 0;
+    CffTop top;
+    if (find_cff(sfnt.get(), &cff, &cffSize) && parse_cff_top(cff, cffSize, &top) &&
+        top.cidKeyed && top.charsetOperand >= 0 && top.charsetOperandLen == 5 &&
+        cff[top.charsetOperand] == 29 && top.charStrings > 0 &&
+        (size_t)top.charStrings + 2 <= cffSize &&
+        be(cff + top.charStrings, 2) == gids.size() + 1) {
+        size_t oldCharset = (size_t)be(cff + top.charsetOperand + 1, 4);
+        size_t oldLen = 0;
+        uint32_t nGlyphs = SkToU32(gids.size() + 1);
+        if (oldCharset < cffSize) {
+            uint8_t fmt = cff[oldCharset];
+            if (fmt == 0) {
+                oldLen = 1 + 2 * (size_t)(nGlyphs - 1);
+            } else if (fmt == 1 || fmt == 2) {
+                size_t entry = fmt == 1 ? 3 : 4, at = oldCharset + 1;
+                for (int64_t covered = 0; covered < (int64_t)nGlyphs - 1 && at + entry <= cffSize;
+                     at += entry) {
+                    covered += (fmt == 1 ? cff[at + 2] : be(cff + at + 2, 2)) + 1;
+                }
+                oldLen = at - oldCharset;
+            }
+        }
+        if (oldCharset + oldLen > cffSize) { oldLen = 0; }
+        // Charset format 0: the CID of glyph 1, 2, ... in turn. Written in place when it fits,
+        // else appended and the operand patched.
+        size_t newLen = 1 + 2 * gids.size();
+        bool inPlace = oldLen >= newLen;
+        sk_sp<SkData> out = SkData::MakeUninitialized(inPlace ? cffSize : cffSize + newLen);
+        uint8_t* o = static_cast<uint8_t*>(out->writable_data());
+        memcpy(o, cff, cffSize);
+        size_t at = inPlace ? oldCharset : cffSize;
+        if (inPlace) { memset(o + oldCharset, 0, oldLen); }
+        o[at] = 0;
+        for (size_t i = 0; i < gids.size(); ++i) {
+            o[at + 1 + 2 * i] = SkToU8(gids[i] >> 8);
+            o[at + 2 + 2 * i] = SkToU8(gids[i] & 0xff);
+        }
+        if (!inPlace) {
+            if (oldLen) { memset(o + oldCharset, 0, oldLen); }
+            o[top.charsetOperand + 1] = SkToU8(at >> 24);
+            o[top.charsetOperand + 2] = SkToU8(at >> 16);
+            o[top.charsetOperand + 3] = SkToU8(at >> 8);
+            o[top.charsetOperand + 4] = SkToU8(at);
+        }
+        return out;
+    }
+
+    // Anything else (a name-keyed CFF, or a subset that did not come out as asked): keep the glyph
+    // ids, as a CFF whose CID == glyph id needs nothing rewritten.
+    sfnt = subset_harfbuzz(typeface, glyphUsage, /*retainGids=*/true);
+    top = CffTop();
+    if (!find_cff(sfnt.get(), &cff, &cffSize) || !parse_cff_top(cff, cffSize, &top)) {
+        return nullptr;
+    }
+    return top.cidKeyed ? nullptr : SkData::MakeWithCopy(cff, cffSize);
+}
