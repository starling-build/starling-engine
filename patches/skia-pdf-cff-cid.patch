+// Whether this OpenType/CFF face can be embedded as a bare CFF subset. Decided once per typeface
+// by subsetting a single glyph; the structure SkPDFSubsetCFF needs is the same for any glyph set.
+static bool cff_embeddable(const SkPDFStrike& pdfStrike) {
+    const SkTypeface& typeface = pdfStrike.fPath.fStrikeSpec.typeface();
+    SkPDFDocument* doc = pdfStrike.fDoc;
+    if (bool* known = doc->fCFFEmbeddable.find(typeface.uniqueID())) {
+        return *known;
+    }
+    SkPDFGlyphUse probe(1, 1);
+    probe.set(1);
+    bool ok = SkToBool(SkPDFSubsetCFF(typeface, probe));
+    doc->fCFFEmbeddable.set(typeface.uniqueID(), ok);
+    return ok;
+}
