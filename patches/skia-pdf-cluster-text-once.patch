 namespace {
+// A cluster with a virama (conjunct, reph) keeps its text in one span over all its glyphs: its glyphs are not in
+// logical order, so splitting the text onto one glyph lost reph text in the Marathi print (xs 72d5ef87).
+bool cluster_has_virama(const char* t, size_t n) {
+    for (size_t i = 0; i + 2 < n; ++i) {
+        if ((uint8_t)t[i] < 0xE0 || (uint8_t)t[i] > 0xEF) continue;
+        unsigned cp = ((t[i] & 0xF) << 12) | ((t[i + 1] & 0x3F) << 6) | (t[i + 2] & 0x3F);
+        switch (cp) {
+            case 0x94D: case 0x9CD: case 0xA4D: case 0xACD: case 0xB4D: case 0xBCD: case 0xC4D:
+            case 0xCCD: case 0xD4D: case 0xDCA: case 0x1039: case 0x17D2: return true;
+            default: break;
+        }
+    }
+    return false;
+}
+}  // namespace
