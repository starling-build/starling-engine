+// The layout's own zero-width spacers: U+2060, U+200B and U+FEFF (UTF-8). They stand in no source.
+static bool isLayoutSpacer(const char* p) {
+    const uint8_t a = (uint8_t)p[0], b = (uint8_t)p[1], c = (uint8_t)p[2];
+    return (a == 0xE2 && b == 0x81 && c == 0xA0) || (a == 0xE2 && b == 0x80 && c == 0x8B) ||
+           (a == 0xEF && b == 0xBB && c == 0xBF);
+}
